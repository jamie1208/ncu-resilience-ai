# NCU Resilience AI 環境變數範例。
# 複製為 .env 後修改（make up 會在 .env 不存在時自動複製）。.env 永不提交。
# 這裡只放範例值；真正的金鑰、密碼只寫在本機 .env 或部署環境的 secret 中。

# --- 後端（app/core/config.py，前綴 NCU_）---
NCU_ENVIRONMENT=development
NCU_LOG_LEVEL=INFO

# --- PostgreSQL（pgvector/pgvector:pg16）---
# 僅供本機開發；正式環境務必改成強密碼。
POSTGRES_USER=ncu
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ncu_resilience
# 後端由上面三項組出連線字串；主機預設 localhost，compose 內自動改為 db（NCU_DB_HOST）

# --- Redis（Celery broker，P1-T07 起使用）---
NCU_REDIS_URL=redis://redis:6379/0

# --- 對外埠號（只綁定 127.0.0.1）---
API_PORT=8000
WEB_PORT=8088
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- 外部服務金鑰（留空；填入本機 .env）---
# 中央氣象署開放資料授權碼（cwa-alerts 來源，P0-T09 核准）
CWA_API_KEY=
# OpenAI API（P2-T03 起；CI 使用 fake provider，不需要）
OPENAI_API_KEY=

# --- 安全開關 ---
# 自動發布公開提醒；開啟前必須取得使用者明確同意（AGENTS.md 不可違反的規則 6）
AUTO_PUBLISH_ENABLED=false
