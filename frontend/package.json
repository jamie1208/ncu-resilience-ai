  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:playful": "VITE_DESIGN=playful vite",
    "build": "tsc -b && vite build",
    "build:playful": "VITE_DESIGN=playful npm run build",
