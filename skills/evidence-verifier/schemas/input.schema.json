{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence-verifier 輸入",
  "description": "一個事件與它的 1～6 份證據。text 是不可信的來源內容，Skill Runner 會包在 <untrusted_source> 中傳給模型；event 是前面 S02／S03 的摘要，放在 <skill_input> 中，同樣是資料。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence",
    "event"
  ],
  "properties": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "source_code",
          "text"
        ],
        "properties": {
          "evidence_id": {
            "description": "證據識別碼，由 Runner 指定；輸出只能引用這裡出現的值",
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "source_code": {
            "description": "來源代碼（config/sources.yaml）",
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "published_at": {
            "description": "aware UTC 時間（ISO 8601）；官方來源以最新一份為準",
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "event": {
      "description": "要查證的事件（S02／S03 的摘要）",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "category",
        "occurrence_start_date",
        "location"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "facility",
            "weather",
            "security",
            "traffic",
            "health",
            "fire",
            "academic",
            "infosec",
            "none",
            null
          ]
        },
        "occurrence_start_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "location": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50
        }
      }
    }
  }
}
