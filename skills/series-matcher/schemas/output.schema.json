{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "series-matcher 輸出",
  "description": "判斷新事件和某個候選系列是不是同一個主題（同一種問題，不看地點與時間）。符合 OpenAI Structured Outputs strict 子集（skill-standard §6）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "same_topic",
    "target_id",
    "confidence",
    "evidence_ids",
    "evidence_spans",
    "reason",
    "abstain_reason"
  ],
  "properties": {
    "status": {
      "description": "ok：已判斷；abstain：證據不足以看出事件的主題",
      "type": "string",
      "enum": [
        "ok",
        "abstain"
      ]
    },
    "same_topic": {
      "description": "true：與 target_id 的系列同主題；false：和所有候選都不同主題；abstain 時為 null",
      "type": [
        "boolean",
        "null"
      ]
    },
    "target_id": {
      "description": "same_topic 為 true 時為候選的 series_id；false 與 abstain 時為 null",
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "description": "判斷的信心；只能靠推測時較低",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_ids": {
      "description": "抄錄原句的證據，必須存在於輸入",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "evidence_spans": {
      "description": "逐字抄錄、說明新事件是什麼問題的原句；Runner 會比對原句確實存在",
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "quote"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "reason": {
      "description": "一兩句判斷理由；不得包含個資與人名、店名",
      "type": "string",
      "maxLength": 300
    },
    "abstain_reason": {
      "description": "abstain 的原因；ok 時為 null",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "insufficient_evidence",
        null
      ]
    }
  }
}
